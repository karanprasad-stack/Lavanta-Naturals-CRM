# Lavanta Naturals Platform - Backend Server Environment Config (Production)

# Server Port (PaaS platforms like Render/Railway/Heroku inject PORT automatically)
PORT=5000

# Node Environment ('production' | 'development')
NODE_ENV=production

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.2h4y9ee.mongodb.net/lavanta_naturals?retryWrites=true&w=majority

# Frontend Client URL (CRITICAL: Used for CORS whitelist & Socket.IO allowed origins)
# Example: https://lavanta-crm.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app

# Secret Key for JWT Authentication (Use a long, random secure string in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production_2026

# JWT Token Lifetime
JWT_EXPIRES_IN=7d

# Storage Provider & Upload Settings
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=uploads

# Security & Rate Limiting (Optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
EXPORT_RATE_LIMIT_MAX_REQUESTS=20
