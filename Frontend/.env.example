# Lavanta Naturals Platform - Frontend Environment Config (Production)

# Backend REST API Base URL
# If Frontend and Backend are hosted on separate domains (e.g. Vercel & Render):
# VITE_API_URL=https://your-backend-api.onrender.com/api
# If deployed on the same domain with a reverse proxy:
# VITE_API_URL=/api
VITE_API_URL=https://your-backend-api.onrender.com/api

# Real-Time WebSocket Server URL (Socket.IO)
# Set to your backend host URL (without /socket.io path):
VITE_SOCKET_URL=https://your-backend-api.onrender.com

# Application Environment Mode
VITE_APP_ENV=production

# Feature Flags
VITE_ENABLE_AUDIT_LOGS=true
